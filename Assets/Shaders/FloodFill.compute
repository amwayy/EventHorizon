#pragma kernel InitSeeds
#pragma kernel WavefrontPropagate
#pragma kernel GenerateMask

Texture2D<float4> Source;
Texture2D<float> SeedsIn;
RWTexture2D<float> SeedsOut;
RWTexture2D<float> Mask;
RWTexture2D<float> OriginalMask;
float2 SeedPos;
float Tolerance;
uint2 TexSize;

[numthreads(8,8,1)]
void InitSeeds(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TexSize.x || id.y >= TexSize.y) return;

    uint2 seedPixel = uint2(SeedPos);
    float4 targetColor = Source[seedPixel];
    float4 pixel = Source[id.xy];

    float diff = length(pixel.rgb - targetColor.rgb);
    bool isMatch = diff <= Tolerance;

    OriginalMask[id.xy] = isMatch ? 1.0 : 0.0;

    // Only the clicked pixel starts as filled
    bool isClickedPixel = (id.x == seedPixel.x && id.y == seedPixel.y);
    SeedsOut[id.xy] = isClickedPixel ? 1.0 : 0.0;
}

[numthreads(8,8,1)]
void WavefrontPropagate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TexSize.x || id.y >= TexSize.y) return;

    // If already filled, keep it
    if (SeedsIn[id.xy] > 0.5)
    {
        SeedsOut[id.xy] = 1.0;
        return;
    }

    // Only fill if this pixel matches the target color
    if (OriginalMask[id.xy] < 0.5)
    {
        SeedsOut[id.xy] = 0.0;
        return;
    }

    // Check 8-connected neighbors
    bool hasFilledNeighbor = false;

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0) continue;

            int2 neighborPos = int2(id.xy) + int2(x, y);

            if (neighborPos.x < 0 || neighborPos.x >= TexSize.x ||
                neighborPos.y < 0 || neighborPos.y >= TexSize.y)
                continue;

            if (SeedsIn[neighborPos] > 0.5)
            {
                hasFilledNeighbor = true;
                break;
            }
        }
        if (hasFilledNeighbor) break;
    }

    SeedsOut[id.xy] = hasFilledNeighbor ? 1.0 : 0.0;
}

[numthreads(8,8,1)]
void GenerateMask(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TexSize.x || id.y >= TexSize.y) return;
    Mask[id.xy] = SeedsIn[id.xy];
}
